{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "typeRoots": [
      "."
    ],
    "types": [
      "claude-code",
      "claude-code-tools",
      "claude-code-mcp",
      "handily-workitems",
      "handily-quiet-items",
      "handily-board",
      "handily-item-toasts",
      "handily-simple-view",
      "handily-reply-view",
      "handily-filetree",
      "handily-tests"
    ]
  },
  "include": [
    "../../hooks",
    "../../types",
    "../../tests"
  ]
}
