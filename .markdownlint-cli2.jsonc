{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false
    },
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": [
    "node_modules/**",
    ".basicly/core/**",
    ".claude/skills/**",
    ".agents/skills/**",
    ".github/agents/**",
    ".claude/agents/**",
    ".claude/worktrees/**",
    "mods/**/.claude-plugin/types/**",
    "AGENTS.md",
    ".claude/CLAUDE.md",
    ".github/copilot-instructions.md",
    ".claude/rules/**",
    ".claude/output-styles/**"
  ],
  "overrides": [
    {
      "filter": ["changelog.d/*.*.md"],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    },
    {
      "filter": ["README.md"],
      "config": {
        "MD033": { "allowed_elements": ["div", "img"] },
        "MD041": false
      },
      "combine": "merge"
    }
  ]
}
