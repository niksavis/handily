# Per-machine basicly overrides; harness keys win over basicly.toml.
basicly.local.toml
# Derived folds of the committed event log. The log is the truth; never commit a fold.
.basicly/ledger/snapshot.jsonl
.basicly/ledger/checkpoint-*.jsonl
# Your copy of a file basicly replaced; delete it once you have merged what you want.
*.basicly-bak
# Bytecode the vendored hooks and kits write when they run. Untracked dirt here is not a tracker path, so it refuses the commit that folds the ledger.
__pycache__/
# npm dependencies.
node_modules/
.basicly/ledger/.events.lock
# Worktrees that Agent isolation lanes create.
.claude/worktrees/
